# BLOQUE 4: VISUALIZACIONES Y ESTADÍSTICAS (RÚBRICA)
# =============================================================================
import matplotlib.pyplot as plt
import seaborn as sns

# Estilos
plt.style.use('default')
sns.set_theme(style="whitegrid", context="talk")
plt.rcParams.update({
    'font.size': 11,
    'axes.labelsize': 12,
    'axes.titlesize': 14,
    'xtick.labelsize': 11,
    'ytick.labelsize': 11,
    'figure.titlesize': 16
})

paleta_residuos = ['#2ecc71', '#3498db', '#e67e22', '#95a5a6']
paleta_comunas = sns.color_palette("Blues_d", 5)

# --- GRÁFICO 1: Barras horizontales (Kg por tipo de material) ---
plt.figure(figsize=(10, 5))
data_material = df_real_consolidado.groupby('tipo_material')['peso_kg'].sum().sort_values()
barras_h = plt.barh(data_material.index, data_material.values, color=paleta_residuos, edgecolor='black', height=0.6)
for barra in barras_h:
    ancho = barra.get_width()
    if ancho > 0:
        plt.text(ancho + (data_material.max() * 0.02), barra.get_y() + barra.get_height()/2,
                 f'{ancho:,.2f} Kg', va='center', ha='left', fontsize=11, fontweight='bold', color='#2c3e50')
plt.title('Distribución Total de Carga Reciclada por Tipo de Material', pad=20, fontweight='bold')
plt.xlabel('Peso Total Acumulado (Kg)')
plt.ylabel('Tipo de Residuo')
plt.tight_layout()
plt.show()

# --- GRÁFICO 2: Barras verticales (Kg por comuna del punto limpio) ---
plt.figure(figsize=(10, 5))
data_comuna = df_real_consolidado.groupby('comuna')['peso_kg'].sum().sort_values(ascending=False)
barras_v = plt.bar(data_comuna.index, data_comuna.values, color=paleta_comunas, edgecolor='black', width=0.5)
for barra in barras_v:
    alto = barra.get_height()
    if alto > 0:
        plt.text(barra.get_x() + barra.get_width()/2, alto + (data_comuna.max() * 0.02),
                 f'{alto:,.1f}\nKg', va='bottom', ha='center', fontsize=10, fontweight='bold', color='#2c3e50')
plt.title('Volumen de Residuos Sólidos Capturados por Comuna Monitoreada', pad=20, fontweight='bold')
plt.ylabel('Carga Recibida Total (Kg)')
plt.xlabel('Puntos Limpios Municipales')
plt.xticks(rotation=15)
plt.tight_layout()
plt.show()

# --- GRÁFICO 3: Mapa de calor (comuna residencia vs tipo material) ---
plt.figure(figsize=(11, 6))
pivot_real = df_real_consolidado.pivot_table(values='peso_kg', index='comuna_residencia', columns='tipo_material', aggfunc='sum').fillna(0)
sns.heatmap(pivot_real, annot=True, fmt=".1f", cmap="tab10", linewidths=1.5, linecolor='black',
            cbar_kws={'label': 'Total Acumulado en Kg'})
plt.title('Matriz de Densidad: Intensidad de Reciclaje\n(Comuna del Vecino vs Tipo de Material)', pad=20, fontweight='bold')
plt.xlabel('Categoría del Material Reciclable')
plt.ylabel('Ubicación Domiciliaria del Usuario')
plt.tight_layout()
plt.show()

# --- ESTADÍSTICAS EXTRA (RÚBRICA) ---
print("\n" + "="*80)
print(" ACCIONES ESTADÍSTICAS SOLICITADAS:\n")

print("1. Peso promedio (Kg) por entrega unitaria según sector:")
print(df_real_consolidado.groupby(['comuna', 'tipo_material'])['peso_kg'].mean().unstack().round(2).fillna(0))
print("-"*80)

print("2. Percentil 90 de carga (Kg) por tipo de material:")
print(df_real_consolidado.groupby('tipo_material')['peso_kg'].quantile(0.90).round(2))
print("-"*80)

print("3. Variabilidad (desviación estándar) de EcoPuntos por comuna:")
print(df_real_consolidado.groupby('comuna')['eco_puntos_otorgados'].std().round(2))
print("-"*80)

# --- GRÁFICO 4: Dispersión Relacional Peso vs EcoPuntos ---
plt.figure(figsize=(10, 6))
for i, mat in enumerate(df_real_consolidado['tipo_material'].unique()):
    sub_df = df_real_consolidado[df_real_consolidado['tipo_material'] == mat]
    plt.scatter(sub_df['peso_kg'], sub_df['eco_puntos_otorgados'],
                label=mat, color=paleta_residuos[i % len(paleta_residuos)], alpha=0.7, s=45)
plt.title('Dispersión: Relación entre Peso e Incentivos (EcoPuntos)', pad=15, fontweight='bold')
plt.xlabel('Peso Neto (Kg)')
plt.ylabel('EcoPuntos Otorgados')
plt.legend(title="Tipo de Material")
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.show()

print("\n✅ Análisis completo.")